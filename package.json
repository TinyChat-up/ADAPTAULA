{
  "name": "adaptaula",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm smoke:raster && pnpm smoke:pdf && pnpm check:secrets",
    "smoke:raster": "node scripts/smoke-raster.mjs",
    "smoke:pdf": "node scripts/smoke-pdf.mjs",
    "qa:visual": "vitest run --config vitest.visual-qa.config.mts",
    "check:secrets": "node --env-file-if-exists=.env.local --import tsx scripts/check-secrets.ts",
    "db:setup-sql": "node scripts/build-setup-sql.mjs",
    "test:e2e": "playwright test",
    "eval:analysis": "node --env-file-if-exists=.env.local --import tsx evals/material-analysis/run.ts",
    "eval:analysis:mock": "node --import tsx evals/material-analysis/run.ts --mock",
    "eval:analysis:size": "node --import tsx evals/material-analysis/size.ts",
    "eval:analysis:compare": "node --import tsx evals/material-analysis/compare.ts",
    "eval:analysis:sanity": "node --env-file-if-exists=.env.local --import tsx evals/material-analysis/sanity.ts",
    "eval:analysis:preflight": "node --env-file-if-exists=.env.local --import tsx evals/material-analysis/preflight.ts",
    "jobs:adaptations": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/run-adaptation-jobs.ts",
    "eval:adaptation:mock": "node --import tsx evals/adaptation/run.ts",
    "eval:adaptation:planner": "node --env-file-if-exists=.env.local --import tsx evals/adaptation/planner-run.ts",
    "eval:adaptation:generator": "node --env-file-if-exists=.env.local --import tsx evals/adaptation/generator-run.ts",
    "eval:adaptation:ab:mock": "node --import tsx evals/adaptation/generator-ab.ts",
    "eval:adaptation:planner:ab:mock": "node --import tsx evals/adaptation/planner-ab.ts",
    "eval:adaptation:reviewer:mock": "node --import tsx evals/adaptation/reviewer-offline.ts",
    "eval:adaptation:reviewer:adversarial": "node --env-file-if-exists=.env.local --import tsx evals/adaptation/reviewer-adversarial-run.ts",
    "eval:adaptation:reviewer": "node --env-file-if-exists=.env.local --import tsx evals/adaptation/reviewer-run.ts",
    "test:rls:real": "node --env-file-if-exists=.env.test.local ./node_modules/vitest/vitest.mjs run tests/rls-real",
    "test:cleanup:real": "node --env-file-if-exists=.env.test.local scripts/cleanup-test-data.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@napi-rs/canvas": "1.0.10",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
