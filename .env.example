# Adaptaula — variables de entorno
# Copia este fichero a .env.local y rellena los valores. Nunca subas valores reales al repositorio.
# Solo las variables NEXT_PUBLIC_* llegan al navegador: jamás pongas secretos en ellas.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "Publishable key" (sb_publishable_...). Vale también la "anon key" legacy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). Vale también la "service_role key" legacy.
# Solo servidor (src/lib/supabase/admin.ts). Salta la RLS: no exponer nunca.
SUPABASE_SECRET_KEY=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Los IDs de precio viven en la tabla `plans` (cargados con el script de setup).

# --- Proveedores de IA (solo servidor) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Alias de modelo -> "proveedor:modelo". La lógica de negocio solo conoce los alias.
# Verifica los IDs de OpenAI en su documentación oficial antes de usarlos.
AI_MODEL_ECONOMY=anthropic:claude-haiku-4-5
AI_MODEL_STANDARD=anthropic:claude-sonnet-5-5
AI_MODEL_PREMIUM=anthropic:claude-opus-5-5
AI_MODEL_IMAGE_FAST=
AI_MODEL_IMAGE_QUALITY=
# Fallback por alias cuando PROVIDER_FALLBACK está activo (opcional, mismo formato).
AI_FALLBACK_ECONOMY=
AI_FALLBACK_STANDARD=
AI_FALLBACK_PREMIUM=

# Análisis de materiales (Fase 3). El alias decide el modelo; se puede cambiar sin tocar código.
AI_ANALYSIS_ALIAS=STANDARD
AI_ANALYSIS_EFFORT=medium
# Versión del prompt de análisis: 3 (la activa por defecto; MaterialAnalysis v3, validado con llamadas reales), 2 (mismo contrato,
# sin los ajustes de v3) o 1 (histórica; guarda MaterialAnalysis v2, que se lee como v3). Las tres siguen disponibles e inmutables.
AI_ANALYSIS_PROMPT_VERSION=3
# Intentos extra si la salida no cumple el esquema (máximo 1: nunca un bucle abierto).
AI_ANALYSIS_MAX_REPAIR_ATTEMPTS=1
AI_ANALYSIS_MAX_OUTPUT_TOKENS=24000
# Para desarrollo y E2E sin gastar: AI_MODEL_STANDARD=mock:default. Se rechaza en producción (VERCEL_ENV=production).
MOCK_AI_DELAY_MS=600

# Reintentos de revisión pedagógica por adaptación.
AI_MAX_REVIEW_RETRIES=2

# --- Barreras de coste de IA (USD, servidor) ---
DAILY_AI_COST_ALERT_USD=50
MONTHLY_AI_COST_ALERT_USD=800
MAX_SINGLE_JOB_COST_USD=1.5

# --- Tareas programadas ---
# Secreto que deben enviar las llamadas a /api/cron/* (cabecera Authorization: Bearer).
CRON_SECRET=
# Etapas de adaptación: trabajos por ejecución del planificador y edad mínima (s) para que el reconciliador repare una adaptación sin job.
ADAPTATION_JOBS_PER_RUN=2
ADAPTATION_RECONCILE_MIN_AGE_SECONDS=60

# --- Admin ---
# Emails con acceso de system_admin que se crean en el seed local. En producción se gestiona en BD.
ADMIN_BOOTSTRAP_EMAILS=

# --- Feature flags (true/false) ---
FLAG_MAX_PLAN_ENABLED=false
FLAG_AI_IMAGES_ENABLED=false
FLAG_MULTI_PROFILE_GENERATION=true
FLAG_SCHOOL_WORKSPACES=false
FLAG_GOOGLE_AUTH=false
FLAG_ADVANCED_EDITOR=true
FLAG_PROVIDER_FALLBACK=false
