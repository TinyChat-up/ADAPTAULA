# Adaptaula — variables de entorno
# Copia este fichero a .env.local y rellena los valores. Nunca subas valores reales al repositorio.
# Solo las variables NEXT_PUBLIC_* llegan al navegador: jamás pongas secretos en ellas.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "Publishable key" (sb_publishable_...). Vale también la "anon key" legacy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). Vale también la "service_role key" legacy.
# Solo servidor (src/lib/supabase/admin.ts). Salta la RLS: no exponer nunca.
SUPABASE_SECRET_KEY=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Precio mensual de Max en Stripe (price_…). Por ahora solo se aceptan claves sk_test_ (modo prueba) y el precio
# debe ser recurrente mensual, en EUR, con IVA incluido y del mismo importe que Max en el catálogo.
# La contratación de Max se enciende con FLAG_MAX_PLAN_ENABLED.
STRIPE_PILOT_PRICE_ID=

# --- Proveedores de IA (solo servidor) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Alias de modelo -> "proveedor:modelo". La lógica de negocio solo conoce los alias.
# Verifica los IDs de OpenAI en su documentación oficial antes de usarlos.
AI_MODEL_ECONOMY=anthropic:claude-haiku-4-5
AI_MODEL_STANDARD=anthropic:claude-sonnet-5-5
AI_MODEL_PREMIUM=anthropic:claude-opus-5-5
AI_MODEL_IMAGE_FAST=
AI_MODEL_IMAGE_QUALITY=
# Fallback por alias cuando PROVIDER_FALLBACK está activo (opcional, mismo formato).
AI_FALLBACK_ECONOMY=
AI_FALLBACK_STANDARD=
AI_FALLBACK_PREMIUM=

# Análisis de materiales (Fase 3). El alias decide el modelo; se puede cambiar sin tocar código.
AI_ANALYSIS_ALIAS=STANDARD
AI_ANALYSIS_EFFORT=medium
# Versión del prompt de análisis: 3 (la activa por defecto; MaterialAnalysis v3, validado con llamadas reales), 2 (mismo contrato,
# sin los ajustes de v3) o 1 (histórica; guarda MaterialAnalysis v2, que se lee como v3). Las tres siguen disponibles e inmutables.
AI_ANALYSIS_PROMPT_VERSION=3
# Intentos extra si la salida no cumple el esquema (máximo 1: nunca un bucle abierto).
AI_ANALYSIS_MAX_REPAIR_ATTEMPTS=1
AI_ANALYSIS_MAX_OUTPUT_TOKENS=24000
# Para desarrollo y E2E sin gastar: AI_MODEL_STANDARD=mock:default. Se rechaza en producción (VERCEL_ENV=production).
MOCK_AI_DELAY_MS=600

# Reglas pedagógicas privadas del planificador v3 (ADR-045). Nunca se versionan: viven en el bucket privado `agent-rules`
# (storage) o en una copia local FUERA de cualquier repositorio (directory + AGENT_RULES_DIR). Sin origen, v3 no se ejecuta.
AGENT_RULES_SOURCE=
AGENT_RULES_DIR=

# Reintentos de revisión pedagógica por adaptación.
AI_MAX_REVIEW_RETRIES=2

# --- Barreras de coste de IA (USD, servidor) ---
DAILY_AI_COST_ALERT_USD=50
MONTHLY_AI_COST_ALERT_USD=800
MAX_SINGLE_JOB_COST_USD=1.5

# --- Tareas programadas ---
# Secreto que deben enviar las llamadas a /api/cron/* (cabecera Authorization: Bearer).
CRON_SECRET=
# Cron de RECUPERACIÓN (diario): las etapas pedidas por el docente se ejecutan al momento en su propia petición; el cron solo
# recupera los jobs ya iniciados que nadie terminó (nunca arranca una adaptación que el docente no ha empezado).
# Etapas recuperadas por ejecución.
ADAPTATION_JOBS_PER_RUN=1

# --- Admin ---
# Emails con acceso de system_admin que se crean en el seed local. En producción se gestiona en BD.
ADMIN_BOOTSTRAP_EMAILS=

# --- Feature flags (true/false) ---
# Etapa 2.2: qué hace una respuesta LITERAL y fiable dentro de un apoyo generado. dry_run (por defecto): solo se registra junto a la
# revisión determinista, sin cambiar nada; on: activación explícita (se repara la decisión y se sustituye el apoyo una vez); off: desactivada.
SUPPORT_SUBSTITUTION_MODE=dry_run
# Etapa 2.3: revisión semántica de los apoyos (pedagogical_reviewer@v2). off (por defecto): revisor v1 sin cambios; shadow: el revisor v2 juzga y los juicios semánticos solo
# se REGISTRAN (sin consecuencias), pero los hallazgos generales los da la misma llamada v2 y pueden diferir de v1 (no es transparente); on: sus hallazgos confirmados suspenden la revisión y se reparan (solo tras validar y autorizar).
REVIEWER_V2_MODE=off
FLAG_MAX_PLAN_ENABLED=false
FLAG_AI_IMAGES_ENABLED=false
FLAG_MULTI_PROFILE_GENERATION=true
FLAG_SCHOOL_WORKSPACES=false
FLAG_GOOGLE_AUTH=false
FLAG_ADVANCED_EDITOR=true
FLAG_PROVIDER_FALLBACK=false

# Piloto aislado de ilustraciones: cerrado si falta cualquiera de estos valores.
# Cinco imágenes del piloto privado NO cambian el catálogo ni son un derecho comercial público.
# AI_IMAGES_PILOT_MODE=local
# AI_IMAGES_PILOT_SUPABASE_URL=http://127.0.0.1:54399
# AI_IMAGES_PILOT_WORKSPACE_ID=UUID_DEL_WORKSPACE_FICTICIO
# Producción requiere explícitamente production-pilot (no staging), backend y workspace exactos.
# El piloto Stripe de TEST y sus cinco imágenes necesitan migración 030; caduca en siete días.

# Piloto del planificador V3 desde la interfaz (ADR-046): cerrado si falta cualquiera de estos valores.
# Nunca en producción (no hay modo de producción). Un solo workspace y un backend Supabase de staging AISLADO.
# AI_PILOT_BUDGET_USD activa el libro de gasto: cada petición de pago a la IA se cuenta y se reserva antes de hacerse,
# y las imágenes quedan bloqueadas en ese despliegue. Sin presupuesto, V3 no se puede elegir.
# FLAG_PLANNER_V3_PILOT=false
# AI_PLANNER_V3_PILOT_MODE=staging   # staging | local | production-pilot (producción solo con ese modo, que no funciona en ningún otro sitio)
# AI_PLANNER_V3_PILOT_SUPABASE_URL=https://REF_DE_STAGING.supabase.co
# AI_PLANNER_V3_PILOT_WORKSPACE_ID=UUID_DEL_WORKSPACE_DE_PRUEBAS
# AI_PILOT_BUDGET_USD=10   # solo mide las llamadas del workspace AI_PLANNER_V3_PILOT_WORKSPACE_ID; los demás no pasan por el libro
# AI_PILOT_CAMPAIGN=piloto-v22-1
